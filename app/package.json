{
  "name": "aera-vision",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,counter -c blue,green \"npm:dev:web\" \"npm:dev:counter\"",
    "predev:web": "node scripts/sync-results.mjs",
    "dev:web": "next dev --port 3100",
    "dev:counter": "cd ../counter && ../model/.venv/bin/python download_model.py && ../model/.venv/bin/python app.py",
    "prebuild": "node scripts/sync-results.mjs",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types 'lib/**/*.test.ts'",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "concurrently": "9.2.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
